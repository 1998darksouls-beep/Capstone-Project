              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "\"Thanks! What is your phone number?\""
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        },
        "6ad0ca6614043aa0aed548a4": {
          "variants": {
            "default:en-us": [
              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "\"Last step! What is your email address so we can send your confirmation?\""
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        },
        "6ad0d53e766fd246c2dd5de4": {
