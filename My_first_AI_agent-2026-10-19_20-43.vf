              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "\"I understand you need priority assistance. Please briefly describe your concern (e.g., allergy, medical urgency, or custom bridal request) so I can alert our senior specialist:\""
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        },
