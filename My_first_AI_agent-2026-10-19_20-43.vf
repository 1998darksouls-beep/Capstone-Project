                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "\"Welcome to Aura Glow Studio! Would you like to book a Salon/Clinic appointment, or do you need urgent specialist assistance?\""
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        },
        "6ad0c57f9010b69708081b5b": {
          "variants": {
