  "responseMessages": [
    {
      "id": "6ad0bdd89010b69708081ad1",
      "discriminatorID": "6ad0bdd89010b69708081ad0",
      "text": [
        {
          "text": [
            "\"Welcome to Aura Glow Studio! Would you like to book a Salon/Clinic appointment, or do you need urgent specialist assistance?\""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T11:49:45.000Z"
    },
    {
      "id": "6ad0c3509010b69708081b43",
      "discriminatorID": "6ad0c3509010b69708081b42",
      "text": [
        {
          "text": [
            "\"Welcome to Aura Glow Studio! Would you like to book a Salon/Clinic appointment, or do you need urgent specialist assistance?\""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T12:13:04.000Z"
    },
    {
      "id": "6ad0c57f9010b69708081b5d",
      "discriminatorID": "6ad0c57f9010b69708081b5c",
      "text": [
        {
          "text": [
            "\"Which service would you like to book today? (Hydrafacial, Balayage, Massage, Laser Consultation, Keratin, or Bridal Makeover)\""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T12:22:24.000Z"
    },
    {
      "id": "6ad0c9c214043aa0aed54879",
      "discriminatorID": "6ad0c9c214043aa0aed54878",
      "text": [
        {
          "text": [
            "\"What date and time works best for your appointment? (e.g., Tomorrow at 4 PM)\""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T12:40:35.000Z"
    },
    {
      "id": "6ad0c9f614043aa0aed54886",
      "discriminatorID": "6ad0c9f614043aa0aed54885",
      "text": [
        {
          "text": [
            "\"Got it! May I have your full name?\""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T12:41:26.000Z"
    },
    {
      "id": "6ad0ca3014043aa0aed54893",
      "discriminatorID": "6ad0ca3014043aa0aed54892",
      "text": [
        {
          "text": [
            "\"Thanks! What is your phone number?\""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T12:42:25.000Z"
    },
    {
      "id": "6ad0ca6614043aa0aed548a6",
      "discriminatorID": "6ad0ca6614043aa0aed548a5",
      "text": [
        {
          "text": [
            "\"Last step! What is your email address so we can send your confirmation?\""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T12:43:18.000Z"
    },
    {
      "id": "6ad0d53e766fd246c2dd5de6",
      "discriminatorID": "6ad0d53e766fd246c2dd5de5",
      "text": [
        {
          "text": [
            "\"I understand you need priority assistance. Please briefly describe your concern (e.g., allergy, medical urgency, or custom bridal request) so I can alert our senior specialist:\""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T13:29:35.000Z"
    },
    {
      "id": "6ad0d6d9766fd246c2dd5e10",
      "discriminatorID": "6ad0d6d9766fd246c2dd5e0f",
      "text": [
        {
          "text": [
            "",
            {
              "text": [
                {
                  "text": [
                    "\"Thank you, "
                  ],
                  "attributes": {
                    "color": {
                      "a": 1,
                      "b": 255,
                      "g": 125,
                      "r": 57
                    },
                    "__type": "text"
                  }
                },
                {
                  "variableID": "6ad0bfa49010b69708081aed"
                },
                {
                  "text": [
                    "! Your details have been logged in our system and a confirmation email has been sent to "
                  ],
                  "attributes": {
                    "color": {
                      "a": 1,
                      "b": 255,
                      "g": 125,
                      "r": 57
                    },
                    "__type": "text"
                  }
                },
                {
                  "variableID": "6ad0bfca9010b69708081af5"
                },
                {
                  "text": [
                    ". Have a wonderful day!\""
                  ],
                  "attributes": {
                    "color": {
                      "a": 1,
                      "b": 255,
                      "g": 125,
                      "r": 57
                    },
                    "__type": "text"
                  }
                }
              ],
              "attributes": {
                "url": "\"Thank you, {customer_name}! Your details have been logged in our system and a confirmation email has been sent to {customer_email}. Have a wonderful day!\"",
                "__type": "link"
              }
            },
            ""
          ]
        }
      ],
      "condition": null,
      "delay": null,
      "createdAt": "2026-10-15T13:36:25.000Z"
    }
  ],
