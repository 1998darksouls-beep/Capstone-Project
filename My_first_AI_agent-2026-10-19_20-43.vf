              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "\"Which service would you like to book today? (Hydrafacial, Balayage, Massage, Laser Consultation, Keratin, or Bridal Makeover)\""
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        },
        "6ad0ca3014043aa0aed54891": {
          "variants": {
