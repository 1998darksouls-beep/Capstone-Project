        },
        "messageDelay": {
          "durationMilliseconds": 0
        },
        "defaultVoice": "elevenlabs:eleven_v3_conversational:ZF6FPAbjXT4488VcRRnw",
        "deepgramASR": {
          "silenceWaitMS": 10,
          "punctuationWaitMS": 200,
          "partialWaitMS": 1000,
          "interruptionWaitWords": 1,
          "audioCue": null
        },
        "globalNoReply": {
          "type": "generative",
          "delay": 10,
          "prompt": {
            "model": "voiceflow-core-4.2",
            "system": "The user hasn’t replied in 10 seconds. Ask them if they’re still there, or re-engage them towards the conversations goal.",
            "maxTokens": 10000,
            "temperature": 0.3,
            "reasoningEffort": null
          },
