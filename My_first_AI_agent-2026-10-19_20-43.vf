        "globalNoMatch": {
          "type": "generative",
          "prompt": {
            "model": "voiceflow-core-4.2",
            "system": "You are a helpful AI assistant, the user has asked you a question that you do not know how to answer, try to communicate that you do not know the answer.",
            "maxTokens": 10000,
            "temperature": 0.3,
            "reasoningEffort": null
